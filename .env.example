# Server & Routing
PORT=3000
BASE_URL=http://localhost:3000

# Security: Invalidate all sessions by generating a secure random 64-character secret
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=replace_with_a_secure_random_64_character_hex_secret

# Admin Initial Credentials (used for initial bootstrap and rotation)
ADMIN_EMAIL=admin@shop.com
ADMIN_PASSWORD=replace_with_a_strong_unique_admin_password

# Database:
# For local development: leave empty to use SQLite (shop.db)
# For production (Vercel / Supabase / Neon / RDS): set connection string
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Production Vercel COD order intake is fail-closed; enable only after release checks and commercial hosting approval.
COMMERCE_ENABLED=0

# Payment Gateway - SSLCOMMERZ (sandbox by default; set SSL_LIVE=1 for live)
SSL_LIVE=0
SSL_STORE_ID=
SSL_STORE_PASS=

# Payment Gateway - aamarPay (sandbox by default; set AAMARPAY_LIVE=1 for live)
AAMARPAY_LIVE=0
AAMARPAY_STORE_ID=
AAMARPAY_SIGNATURE=

# Optional: Webhook (Make/Zapier/SMS gateway) that receives new-order JSON
NOTIFY_WEBHOOK=
